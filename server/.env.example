# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=edu_system

# TLS：本机 MariaDB 11.4+ 的自动证书可设置下面两项为 true。
# 加密认证可避开 Windows SHA2 插件的 RSA 解密崩溃；不需要修改数据库账号。
DB_SSL=false
# 仅允许 localhost、127.0.0.1、::1；远程数据库必须验证证书。
DB_SSL_ALLOW_SELF_SIGNED=false
# 远程数据库使用 CA 证书文件的路径，同时设置 DB_SSL=true。
DB_SSL_CA=

# JWT 配置
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 服务器配置
PORT=3001
NODE_ENV=development

# 前端地址（CORS）
FRONTEND_URL=http://localhost:3000
